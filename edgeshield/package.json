{
  "name": "edgeshield",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare edge security demo for side-channel attack detection.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.toml --local --port 8787",
    "deploy": "wrangler deploy --config wrangler.local.toml --env production",
    "deploy:dry-run": "wrangler deploy --config wrangler.local.toml --env production --dry-run",
    "d1:init:local": "wrangler d1 execute edgeshield --config wrangler.local.toml --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute edgeshield --config wrangler.local.toml --remote --env production --file=./schema.sql",
    "test": "node --test tests/*.test.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:dataset": "node scripts/evaluate-dataset.mjs",
    "samples": "node scripts/generate-samples.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.13.0"
  }
}
