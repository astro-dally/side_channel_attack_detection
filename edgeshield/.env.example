# Copy to .env for local shell commands and scripts.
#
# Wrangler does not interpolate D1/KV/R2 resource bindings from .env into
# wrangler.toml. Keep binding names and resource IDs in wrangler.toml, and use
# this file for command-time values such as URLs, account IDs, and optional
# setup notes.

EDGESHIELD_URL=http://127.0.0.1:8787
CLOUDFLARE_ACCOUNT_ID=

# Resource names/IDs to paste into wrangler.toml after creation.
EDGESHIELD_D1_DATABASE_NAME=edgeshield
EDGESHIELD_D1_DATABASE_ID=
EDGESHIELD_KV_NAMESPACE_ID=
EDGESHIELD_KV_PREVIEW_NAMESPACE_ID=
EDGESHIELD_R2_BUCKET=edgeshield-traces
